BYTE_APP_NAME=byte
BYTE_LOG_LEVEL=INFO
# JSON list — one entry per agent segment
BYTE_SEGMENTS=["home","agenda","finance"]
# Model per tier, as <provider>:<model_id>. Falls over to another tier on error or 429.
BYTE_ROUTER_MODEL=groq:openai/gpt-oss-120b
BYTE_FAST_MODEL=groq:openai/gpt-oss-20b
BYTE_BALANCED_MODEL=google:gemini-3.5-flash
BYTE_HEAVY_MODEL=google:gemini-3.7-flash
# Provider keys — no BYTE_ prefix, the SDK names are used as-is
GEMINI_API_KEY=
GROQ_API_KEY=

# LG ThinQ Personal Access Token (https://connect-pat.lgthinq.com)
BYTE_THINQ_ACCESS_SECRET=
BYTE_THINQ_COUNTRY=BR
# Tuya lights over the LAN, by name: {"lampada":{"device_id":"","address":"","local_key":"","version":3.3}}
BYTE_TUYA_LIGHTS=

# Spotify (Premium). Client ID from developer.spotify.com; token via scripts/spotify_login.py
BYTE_SPOTIFY_CLIENT_ID=
BYTE_SPOTIFY_REFRESH_TOKEN=
# Spotify Connect device name, e.g. your Nest Mini
BYTE_SPOTIFY_DEVICE=
