# --- Configurações da sua App (FastAPI/Agno) ---
# Note que mudamos de localhost para 'db'
MARCELO_DATABASE_URL=postgresql+asyncpg://marcelo:marcelo@db:5432/marcelo
MARCELO_AGNO_MODEL_ID=claude-sonnet-4-6
MARCELO_AGNO_ADD_DATETIME=true
MARCELO_AGNO_ADD_LOCATION=true
ANTHROPIC_API_KEY=sk-ant-...

# --- Configurações Exclusivas da Evolution API ---
# URL que a API usará internamente
SERVER_URL=http://localhost:8080

# Chave de segurança para gerenciar a Evolution
AUTHENTICATION_TYPE=apikey
AUTHENTICATION_API_KEY=mude_me

# Conexão da Evolution com o Postgres (Sem asyncpg aqui, a Evolution usa Prisma)
DATABASE_ENABLED=true
DATABASE_CONNECTION_URI=postgresql://marcelo:marcelo@db:5432/marcelo?sslmode=disable
DATABASE_CONNECTION_CLIENT_NAME=evolution_api

# --- Outras Keys (Opcional) ---
GOOGLE_API_KEY=
GROQ_API_KEY=