# --- required ---------------------------------------------------------------
# Bearer token for every route and the WebSocket. At least 32 characters; the app
# refuses to boot otherwise. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
BYTE_API_TOKEN=
# Only needed while a provider below is openai.
BYTE_OPENAI_API_KEY=

# --- models -----------------------------------------------------------------
# Providers: openai (default) | gemini. A provider set to gemini needs BYTE_GEMINI_API_KEY.
BYTE_CHAT_PROVIDER=openai
BYTE_CHAT_MODEL=gpt-4.1-mini
BYTE_GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
BYTE_LIVE_MODEL=gpt-realtime-2.1-mini
# server_vad | semantic_vad (A/B them with your own voice)
BYTE_LIVE_VAD=server_vad

# Gemini needs `pip install .[gemini]`.
BYTE_LIVE_PROVIDER=openai
BYTE_GEMINI_API_KEY=
BYTE_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Male voices: Charon, Puck, Fenrir, Orus. Female: Kore, Aoede, Leda.
BYTE_GEMINI_VOICE=Charon

# --- devices (optional) -----------------------------------------------------
# A group left empty runs against an in-memory fake, and the log says so at boot.
# LG ThinQ Personal Access Token (https://connect-pat.lgthinq.com)
BYTE_THINQ_ACCESS_SECRET=
BYTE_THINQ_COUNTRY=BR
# Tuya lights over the LAN, by name: {"lampada":{"device_id":"","address":"","local_key":"","version":3.3}}
BYTE_TUYA_LIGHTS=
# Spotify (Premium). Client ID from developer.spotify.com; token via scripts/spotify_login.py
BYTE_SPOTIFY_CLIENT_ID=
BYTE_SPOTIFY_REFRESH_TOKEN=
# Spotify Connect device name, e.g. your Nest Mini
BYTE_SPOTIFY_DEVICE=

# Google Calendar. Empty = in-memory calendar. Token via scripts/google_login.py
BYTE_GOOGLE_CLIENT_ID=
BYTE_GOOGLE_CLIENT_SECRET=
BYTE_GOOGLE_REFRESH_TOKEN=
BYTE_GOOGLE_CALENDAR_ID=primary

# --- reminders --------------------------------------------------------------
# The owner's time zone: the model's "now", reminders and calendar days.
BYTE_TIMEZONE=America/Sao_Paulo
# Local Piper voice (python -m piper.download_voices pt_BR-faber-medium --download-dir models).
# Empty = reminders arrive as a beep with no words.
BYTE_PIPER_MODEL=models/pt_BR-faber-medium.onnx
BYTE_REMINDERS_PATH=data/reminders.json

# --- weather ----------------------------------------------------------------
# Home city for the weather ("Cidade, UF"). Open-Meteo: no key, no account.
BYTE_WEATHER_HOME=Goiânia, GO

# --- runtime ----------------------------------------------------------------
BYTE_LOG_LEVEL=INFO
# Serve the web control panel at / (same as `python main.py --web`). Default off.
BYTE_WEB=

# --- LAN exposure (ESP32) ---------------------------------------------------
# Leave empty for loopback only. To expose on the LAN set BOTH the host and the TLS pair;
# never publish without TLS: the bearer token would travel in cleartext.
BYTE_PUBLISH_HOST=
BYTE_TLS_CERT=
BYTE_TLS_KEY=

# Voice client (voice/)
BYTE_VOICE_WAKE_MODEL=models/ei_byte.onnx
BYTE_VOICE_URL=
BYTE_VOICE_THRESHOLD=
BYTE_VOICE_IDLE_SECONDS=
BYTE_VOICE_SEGMENT=
BYTE_VOICE_INPUT_DEVICE=
BYTE_VOICE_OUTPUT_DEVICE=
BYTE_VOICE_LOG_LEVEL=
BYTE_LIVE_DUCK_PERCENT=20

# Projects (Spec 4): JSON map name -> {"path": folder holding CLAUDE.md, "docs": [relative .md]}.
# Example: {"FinFlow":{"path":"D:/Projetos/FinFlow"},"Byte":{"path":"D:/Projetos/Byte/BYTE"}}
BYTE_PROJECTS=
# Vector store (docker compose up db). Unset: in-memory index, rebuilt at boot.
# postgresql+asyncpg://byte:<BYTE_DB_PASSWORD>@127.0.0.1:5432/byte
BYTE_DATABASE_URL=
BYTE_DB_PASSWORD=
BYTE_EMBEDDING_MODEL=
BYTE_KNOWLEDGE_SCAN_SECONDS=
BYTE_CLAUDE_COMMAND=
