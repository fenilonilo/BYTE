# The panel and the API behind one HTTPS origin. `tls internal` signs with Caddy's own CA:
# install its root (see README) on each phone once. A real domain in BYTE_SITE without
# `tls internal` switches to a public certificate.
{$BYTE_SITE:byte.local} {
	tls internal
	encode gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/frontend
		# a new index.html must never pair with a stale stylesheet; ETag still answers 304
		header Cache-Control no-cache
		file_server
	}
}
